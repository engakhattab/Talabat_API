  "components": {
    "schemas": {
      "AgentApprovalStatus": {
        "type": "integer"
      },
      "ApplicationActionResponse": {
        "required": [
          "userId",
          "applicationStatus"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "applicationStatus": {
            "type": "string"
          }
        }
      },
      "DeliveryAgentApplicationResponse": {
        "required": [
          "userId",
          "fullName",
          "email",
          "phoneNumber",
          "vehicleType",
          "applicationStatus",
          "submittedAt"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "vehicleType": {
            "type": "integer",
            "oneOf": [
              {
                "$ref": "#/components/schemas/VehicleType"
              }
            ],
            "nullable": true
          },
          "applicationStatus": {
            "$ref": "#/components/schemas/AgentApprovalStatus"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeliveryAgentStatusActionResponse": {
        "required": [
          "userId",
          "deliveryAgentStatus"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "deliveryAgentStatus": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "VehicleType": {
        "type": "integer"
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "OIDC authorization code flow with PKCE against Talabat.Identity.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://localhost:7237/connect/authorize",
            "tokenUrl": "https://localhost:7237/connect/token",
            "scopes": {
              "openid": "Subject identifier",
              "profile": "Profile claims",
              "roles": "Role claims",
              "admin.api": "Admin API access"
            }
          }
        }
      }
    }
  },
  "tags": [
